# syntax=docker/dockerfile:1
FROM python:3.12-slim AS base
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=on
# Install uv plus venv/pip tooling for the slim image
RUN apt-get update && apt-get install -y python3-venv python3-pip && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv
COPY pyproject.toml uv.lock ./
RUN uv venv .venv --seed && .venv/bin/python -m pip install --no-cache-dir uv
RUN .venv/bin/uv sync --frozen --no-dev
COPY main.py ./
COPY config ./config
COPY routes ./routes
RUN adduser --disabled-password --gecos "" nonroot
USER nonroot
EXPOSE 8000
ENV PATH="/app/.venv/bin:${PATH}"
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
